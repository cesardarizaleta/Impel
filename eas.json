{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0",
      "install": {
        "command": "npm install --legacy-peer-deps"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.13.0",
      "install": {
        "command": "npm install --legacy-peer-deps"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "node": "22.13.0",
      "install": {
        "command": "npm install --legacy-peer-deps"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}